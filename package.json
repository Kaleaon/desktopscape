{
  "name": "desktopscape-peoria-splat",
  "version": "1.0.0",
  "description": "Photorealistic 3D Gaussian Splat Desktop Engine of Peoria, IL with dynamic weather, winter river ice, time-of-day, and night city lighting from 4K YouTube videos.",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "dist": "electron-builder --win nsis",
    "build:exe": "node scripts/packageExe.js",
    "render-test": "node scripts/renderTestScreenshots.js"
  },
  "keywords": [
    "peoria",
    "gaussian-splat",
    "3d",
    "desktop-wallpaper",
    "weather",
    "illinois-river",
    "electron"
  ],
  "author": "Desktopscape Contributors",
  "license": "MIT",
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.desktopscape.peoria.splat",
    "productName": "Peoria Gaussian Splat Desktop Engine",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
